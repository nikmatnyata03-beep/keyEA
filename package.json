{
  "name": "quantum-queen-license",
  "version": "1.0.0",
  "private": true,
  "description": "Seven Sigma - Online license server (Cloudflare Workers + D1) with admin dashboard. 1 device 1 key.",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:init:remote": "wrangler d1 execute quantum-queen-license --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute quantum-queen-license --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
